<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema del wearable. Debe ser un estilo (no un string): el manifiesto lo
      referencia como @style/AppTheme y el sistema solo acepta un recurso de
      tipo style en android:theme.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault" />
</resources>

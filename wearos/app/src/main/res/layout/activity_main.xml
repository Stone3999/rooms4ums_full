<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/acento"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/status_iniciando"
                android:textColor="@color/texto"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- La sesión NO se captura aquí: la manda el celular por Data Layer. -->
            <TextView
                android:id="@+id/sesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/status_esperando_vinculo"
                android:textColor="@color/texto_suave"
                android:textSize="9sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/sensores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/status_sensores"
                android:textColor="@color/texto_suave"
                android:textSize="9sp"
                android:fontFamily="monospace" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
